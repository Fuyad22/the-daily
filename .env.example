# Postgres (Neon) — https://neon.tech
# Pooled connection string, used by the app at runtime.
DATABASE_URL=

# Neon's direct (unpooled) connection string, used for migrations.
DIRECT_URL=

# Auth (Better Auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend) — https://resend.com
# Verification and password-reset emails log to the console when unset.
RESEND_API_KEY=
EMAIL_FROM="The Daily <onboarding@resend.dev>"

# Stripe — https://dashboard.stripe.com
# Subscriptions show "coming soon" until these are set. Note: Stripe does not
# pay out directly to Bangladesh — this unblocks testing in Stripe test mode,
# not real revenue collection.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
