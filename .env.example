# Postgres
# Local dev: postgresql://USER:PASSWORD@localhost:PORT/DATABASE (same value
# for both — no pooler locally). Hosted (Supabase, Neon, etc.): DATABASE_URL
# is the pooled/runtime string, DIRECT_URL the direct one used for migrations.
DATABASE_URL=
DIRECT_URL=

# Auth (Better Auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend) — https://resend.com
# Verification and password-reset emails log to the console when unset.
RESEND_API_KEY=
EMAIL_FROM="The Daily Issue <onboarding@resend.dev>"

# Stripe — https://dashboard.stripe.com
# Subscriptions show "coming soon" until these are set. Note: Stripe does not
# pay out directly to Bangladesh — this unblocks testing in Stripe test mode,
# not real revenue collection.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=

# Upstash Redis — https://upstash.com (rate limiting: comments, etc.)
# Falls back to an in-memory limiter when unset (fine for dev, not for
# production/serverless — resets on restart, not shared across instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — create a store at https://vercel.com/dashboard/stores
# Without this, the hero image field and in-editor image button fall back to
# pasting a URL instead of uploading a file.
BLOB_READ_WRITE_TOKEN=

# Google Cloud Translation (Basic/v2) — https://console.cloud.google.com
# Create a project, enable "Cloud Translation API", then create an API key
# (needs a billing account attached, but 500k chars/month are free). Without
# this, the "বাংলায় পড়ুন" button on articles is hidden entirely. Each
# article is translated once and cached — later readers hit the cache.
GOOGLE_TRANSLATE_API_KEY=
